# Managed by ~/.tools (github.com/aadilzbhatti/tools). Put machine-specific
# stuff in ~/.zshrc.local so this file can stay a symlink.

# PATH is set in ~/.zshenv. On macOS, /etc/zprofile's path_helper then moves
# system dirs to the front for login shells, so put Homebrew back ahead of them.
[[ -n "$HOMEBREW_PREFIX" ]] && path=("$HOMEBREW_PREFIX/bin" "$HOMEBREW_PREFIX/sbin" $path)
path=("$HOME/.local/bin" $path)
export EDITOR=vim

# --- oh-my-zsh --------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="agnoster"
DEFAULT_USER="$USER"            # hide user@host in the agnoster prompt locally
plugins=(git)
(( $+commands[fzf] )) && plugins+=(fzf)
(( $+commands[zoxide] )) && plugins+=(zoxide)
DISABLE_UPDATE_PROMPT=true
zstyle ':omz:update' mode auto
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# --- History ----------------------------------------------------------------
HISTSIZE=50000
SAVEHIST=50000
setopt share_history hist_ignore_dups hist_ignore_space

# --- Aliases ----------------------------------------------------------------
command -v eza >/dev/null && alias ls='eza' ll='eza -lah --git' lt='eza --tree --level=2'
command -v bat >/dev/null && alias cat='bat --paging=never --style=plain'
command -v batcat >/dev/null && alias bat='batcat' cat='batcat --paging=never --style=plain'  # Debian/Ubuntu name

# ssh into a host and attach to tmux with iTerm2's native tmux integration
tssh() { ssh "$@" -t 'tmux -CC -u attach || tmux -CC -u new'; }

# Update everything: this repo, brew packages, oh-my-zsh, vim plugins
alias tools-update='~/.tools/install.sh'

if [[ -f ~/.zshrc.local ]]; then source ~/.zshrc.local; fi
